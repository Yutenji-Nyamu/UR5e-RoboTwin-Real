# Source snapshots below are ordinary files tracked by this repository.
.third_party/*
!.third_party/RoboTwin/
!.third_party/MetisWAM4D/
.third_party/MetisWAM4D/UNRESOLVED_EXTERNAL_LINKS.json
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local laboratory configuration and credentials
configs/lab.yaml
.env
.env.*
!.env.example

# Live runtime files stay local; small evidence snapshots are versioned under
# docs/experiments/evidence via scripts/archive_experiment_evidence.py.
/data/
/raw/
/outputs/
/logs/
/checkpoints/
act_ckpt/
processed_data/
RoboTwin_like_data/
*.hdf5
*.h5
*.bag
*.mp4
*.avi
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors

# Small diagnostic arrays and archived source paths can match generic rules above.
# Size is checked separately by the evidence exporter and repository hygiene test.
!/docs/experiments/evidence/**

# Editors and OS
.vscode/
.idea/
.DS_Store
