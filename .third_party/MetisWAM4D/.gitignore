# # MetisWAM4D unit tests are part of the repository.
# !/tests/
# !/tests/*.py

# Keep Fusion-v3 evaluator regression tests reviewable.  The broad legacy
# patterns above otherwise hide every new file below this tracked test suite.
!fusion_v3/tests/
!fusion_v3/tests/test_*.py
!robodojo_v3/tests/
!robodojo_v3/tests/__init__.py
!robodojo_v3/tests/test_*.py
logs*
*.log
.pytest_cache/
